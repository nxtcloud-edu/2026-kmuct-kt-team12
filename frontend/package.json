{
  "name": "@kiroton/frontend",
  "version": "0.1.0",
  "description": "포트폴리오 생성기 프론트엔드: Vite + React SPA, HashRouter 6화면",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "package": "node scripts/package.mjs"
  },
  "dependencies": {
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-router-dom": "6.27.0"
  },
  "devDependencies": {
    "@types/react": "18.3.11",
    "@types/react-dom": "18.3.1",
    "@types/node": "22.7.5",
    "@vitejs/plugin-react": "4.3.2",
    "typescript": "5.6.3",
    "vite": "5.4.9",
    "vitest": "2.1.3"
  },
  "allowScripts": {
    "esbuild@0.21.5": true
  }
}
